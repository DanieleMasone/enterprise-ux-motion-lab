{
  "name": "enterprise-ux-motion-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A production-grade React and TypeScript lab for functional enterprise UX micro-interactions.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docs": "typedoc --options typedoc.json",
    "build:stats": "npm run build && node scripts/build-stats.mjs",
    "pages:build": "npm run test:coverage && npm run docs && npm run build && node scripts/prepare-pages.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "motion": "^12.40.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "overrides": {
    "typedoc": {
      "minimatch": "^11.0.1"
    }
  }
}
